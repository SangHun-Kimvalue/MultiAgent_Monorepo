{
  "schema_version": 1,
  "groups": [
    {
      "id": "ztr-engine-tests",
      "cwd": ".",
      "argv": [
        "runtimes/ztr/.venv/Scripts/python.exe",
        "-m",
        "pytest",
        "-q",
        "runtimes/ztr/tests"
      ],
      "scope_class": "module-full"
    },
    {
      "id": "ztr-full",
      "cwd": ".",
      "argv": [
        "runtimes/ztr/.venv/Scripts/python.exe",
        "-m",
        "pytest",
        "-q",
        "runtimes/ztr"
      ],
      "scope_class": "repository-full"
    }
  ],
  "rules": [
    {
      "id": "ztr-engine-prefix",
      "match": {"kind": "prefix", "value": "runtimes/ztr/src/engine/"},
      "groups": ["ztr-engine-tests"]
    },
    {
      "id": "ztr-static-review-exact",
      "match": {"kind": "exact", "value": "runtimes/ztr/src/engine/static_review.py"},
      "groups": ["ztr-full"]
    }
  ]
}
